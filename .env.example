# ais-its-geo-service — every variable the service reads (docs/PLATFORM_SPEC.md §4).
# Copy to .env for local development; real secrets never go into the repository.

# --- Service -------------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=geo
# Defaults to the package.json version.
# SERVICE_VERSION=0.1.0
HOST=0.0.0.0
PORT=3009
LOG_LEVEL=info
# Pretty logs need the dev dependency pino-pretty; defaults to true in development.
LOG_PRETTY=true
# Graceful shutdown deadline (SIGTERM → readiness 503 → drain → exit).
SHUTDOWN_TIMEOUT_MS=30000

# --- PostgreSQL (TimescaleDB + PostGIS), schema "geo" ---------------------
DATABASE_URL=postgres://geo_svc:geo_svc@localhost:5432/aisits
DATABASE_SCHEMA=geo
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Apply migrations/ at startup (also `pnpm migrate`).
DB_MIGRATE_ON_BOOT=true

# --- NATS JetStream --------------------------------------------------------------
# Comma separated list allowed. geo produces GEO (zone snapshots) and AUDIT.
NATS_URL=nats://localhost:4222
# Prefix of durable consumer names (shared test servers); geo has no durable consumer.
# NATS_DURABLE_PREFIX=

# --- Valkey (not used by geo: no RedisModule; kept for the common schema) --------
REDIS_URL=redis://localhost:6379

# --- Authentication (spec §8) ----------------------------------------------------
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
AUTH_ISSUER=ais-its-auth
AUTH_AUDIENCE=ais-its-api
# API-key introspection (routes marked @AllowApiKey).
AUTH_INTERNAL_URL=http://localhost:3001
# X-Internal-Token for /internal/* — at least 16 characters and not this value in production.
INTERNAL_TOKEN=dev-internal-token-change-me

# --- HTTP ------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000
# Proxies whose X-Forwarded-For is trusted (IPs, CIDRs, loopback/linklocal/uniquelocal, none).
TRUSTED_PROXIES=loopback,linklocal,uniquelocal
# Largest request body, bytes (4 MiB: a 50 000-vertex zone is ~1.5 MB of GeoJSON).
HTTP_BODY_LIMIT_BYTES=4194304

# --- Zones ---------------------------------------------------------------------------
# Most features of one GET /api/v2/zones/geojson response (more → "truncated": true).
ZONES_GEOJSON_MAX_FEATURES=5000

# --- Transactional outbox relay (GEO + AUDIT events) ----------------------------------
# Run the relay loop in this process (seed jobs and tests may turn it off).
OUTBOX_RELAY_ENABLED=true
# Idle polling interval, ms (a committed change wakes the relay at once).
OUTBOX_POLL_INTERVAL_MS=500
# Rows claimed (FOR UPDATE SKIP LOCKED) per relay transaction.
OUTBOX_BATCH_SIZE=100
# Retry backoff after a failed publication: first delay and cap, ms.
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=60000
# Published rows are deleted after this many hours (failed rows are kept).
OUTBOX_RETENTION_HOURS=24

# --- Tracing (OTLP/HTTP; disabled when unset) --------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
